{
  "expo": {
    "name": "Nepal Police Safety",
    "slug": "nepal-police-safety",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "safetyapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102136"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": ["expo-secure-store", "expo-location", "expo-image-picker"]
  }
}
